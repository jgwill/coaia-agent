        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/permission_request_hook.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/post_tool_use_failure_hook.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/subagent_start_hook.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
