  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/stop_hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/user_prompt_submit_hook.sh"
          },
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/corrective_feedback_hook.sh"
          },
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/accepted_redirection_hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/session_start_hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
