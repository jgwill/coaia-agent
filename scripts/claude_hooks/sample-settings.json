        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/pre_tool_use_hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/post_tool_use_hook.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/notification_hook.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/subagent_stop_hook.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /src/scripts/claude_hooks/pre_compact_hook.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
