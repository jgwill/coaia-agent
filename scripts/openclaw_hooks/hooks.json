{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /a/src/scripts/openclaw_hooks/session_start_hook.sh"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /a/src/scripts/openclaw_hooks/before_tool_hook.sh"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /a/src/scripts/openclaw_hooks/after_tool_hook.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /a/src/scripts/openclaw_hooks/session_end_hook.sh"
          }
        ]
      }
    ]
  }
}
